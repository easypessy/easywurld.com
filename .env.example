# ---------------------------------------------------------------------------
# Easywurld client operations — environment template
#
# Copy to `.env` (git-ignored) and fill in only what you have.
# Everything is optional except in production, where SITE_URL and the admin
# account must be set. A missing integration never breaks the app: emails are
# queued in the outbox, folders fall back to local storage, and Notion sync is
# skipped. See docs/ops/02-integrations.md.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001
SITE_URL=http://localhost:3000

# Where the SQLite database, uploaded files and backups live.
# DATA_DIR=/var/lib/easywurld
# SESSION_DAYS=30

# Brand details used in every email/WhatsApp
EASYWURLD_ADMIN_EMAIL=hello@easywurld.com
EASYWURLD_WHATSAPP=2349050690837
EASYWURLD_ADMIN_NAME=Easywurld

# Comma-separated allowlist of administrator emails.
# ADMIN_EMAILS=you@easywurld.com

# --- Payments (choose one or more; each is verified independently) ---------
# Paystack: Settings → API Keys & Webhooks → secret key, webhook URL
PAYSTACK_SECRET_KEY=
# Flutterwave: Settings → Webhooks → secret hash
FLUTTERWAVE_VERIF_HASH=
FLUTTERWAVE_SECRET_KEY=
# Stripe: `stripe listen` or Dashboard → Webhooks → signing secret
STRIPE_WEBHOOK_SECRET=
# Any other provider (Selar, Gumroad, Payhip…): shared secret sent as
# `x-webhook-secret`. Leave empty to refuse all generic webhooks.
WEBHOOK_SECRET=

# --- Document storage ------------------------------------------------------
# local (default) | gdrive | dropbox
STORAGE_PROVIDER=local
# Google Drive root folder: "EASYWURLD CLIENTS" → 1SABmO4DlvOxn_X2nz-iZ4DskqUqhue0k
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_ACCESS_TOKEN=
# Recommended: refresh-token flow so the token never expires
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Off by default — clients reach files through the portal, not shared links
GOOGLE_DRIVE_SHARE_WITH_CLIENTS=false

# Supplementary media store only — do not duplicate large files
DROPBOX_ACCESS_TOKEN=
DROPBOX_ROOT=/EASYWURLD CLIENTS

# --- Notion mirror (internal working view, never client-facing) ------------
# Use a Notion *internal integration* token scoped to the "Easywurld
# Operations" page. Use the data source IDs returned by the API.
NOTION_TOKEN=
NOTION_CLIENTS_DB=b931e22b-02ce-47cc-816d-a99e26b3f80f
NOTION_PROJECTS_DB=95e436c4-4b11-4a85-a0aa-d1eea3ac31de
NOTION_TASKS_DB=462c4fac-5851-4ee3-b454-c413cc0e11fd
NOTION_DELIVERIES_DB=2818d2cc-28d3-46c6-a918-a45af5b8b265
NOTION_LOG_DB=15346af4-9f62-45d3-a49c-ad87b739bfc3

# --- Email (welcome mail, invites, reminders) ------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Easywurld <hello@easywurld.com>

# --- WhatsApp Cloud API (optional, paid per conversation) ------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Limits ----------------------------------------------------------------
MAX_UPLOAD_MB=25
